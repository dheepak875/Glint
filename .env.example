# All settings are optional — Glint runs with none of them set.

# Admin login. If ADMIN_PASSWORD is unset, one is generated on first start and printed in the
# logs (`docker compose logs glint`); it's also saved in data/secrets.json.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Signs login cookies. Generated and saved in data/secrets.json if unset.
SESSION_SECRET=

# Shown in the browser tab and on the homepage.
SITE_TITLE=Glint

# Host port for docker-compose.yml.
PORT=3000

# Where the database and photos live inside the container. Leave as-is with Docker.
# STORAGE_PATH=/app/data
