# Copy to .env and fill in only what you need — Glint runs with none of these set.

# --- Going public (pick one, see docker-compose.yml) -------------------------------------

# Home server: the token from Cloudflare Zero Trust -> Networks -> Tunnels -> your tunnel.
# Start with: docker compose --profile tunnel up -d
TUNNEL_TOKEN=

# Cloud server: your domain, e.g. photos.example.com (its DNS must point at this server).
# Start with: docker compose --profile caddy up -d
DOMAIN=

# --- Admin ----------------------------------------------------------------------------

# If ADMIN_PASSWORD is empty, one is generated on first start and printed in the logs
# (docker compose logs glint). It's also saved in data/secrets.json.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Signs login cookies. Generated and saved in data/secrets.json if empty.
SESSION_SECRET=

# --- Site -----------------------------------------------------------------------------

# Site title until you set one under Settings in the admin.
SITE_TITLE=Glint

# Your public address, used in link previews and the sitemap. Normally detected automatically;
# set it only if shared links show the wrong address.
# SITE_URL=https://photos.example.com

# --- Docker ---------------------------------------------------------------------------

# Port on this machine. On a cloud server using Caddy, set 127.0.0.1:3000 so Glint is only
# reachable through HTTPS.
GLINT_PORT=3000

# Image version to run, e.g. 0.1.0 to pin. "latest" follows each release.
GLINT_VERSION=latest
